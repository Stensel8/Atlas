{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "#ffffff",
          "background": "#5D5FEF",
          "template": "  {{ .Path }} ",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": "  "
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#ffffff",
          "background": "#2D7DD2",
          "foreground_templates": [
            "{{ if .Detached }}#FFD700{{ end }}"
          ],
          "template": "  {{ .HEAD }}{{ if .Staging.Changed }}  {{ .Staging.Added }}{{ if gt .Staging.Modified 0 }}~{{ .Staging.Modified }}{{ end }}{{ end }}{{ if .Working.Changed }} {{ end }} ",
          "properties": {
            "fetch_status": true
          }
        },
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#ffffff",
          "background_templates": [
            "{{ if gt .Code 0 }}#C0392B{{ else }}#2ECC71{{ end }}"
          ],
          "template": "{{ if gt .Code 0 }} ✘ {{ .Code }} {{ else }} ✔ {{ end }}",
          "properties": {
            "always_enabled": false
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#FFD700",
          "background": "transparent",
          "template": " {{ .FormattedMs }} ",
          "properties": {
            "threshold": 2000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#5D5FEF",
          "background": "transparent",
          "template": "❯ "
        }
      ]
    }
  ]
}
