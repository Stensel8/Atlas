{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    ":dependencyDashboard"
  ],
  "forkProcessing": "enabled",
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "github-actions": {
    "fileMatch": ["^\\.github/workflows/[^/]+\\.ya?ml$"]
  },
  "pinDigests": true,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": false,
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/lint-powershell\\.yml$/"],
      "matchStrings": ["RequiredVersion\\s+(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "PowerShell/PSScriptAnalyzer",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
