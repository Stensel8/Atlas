# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicit overrides for Windows batch files (must stay CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.bmp binary
*.gif binary
*.apbx binary
*.zip binary
*.exe binary
*.dll binary
